# Firebase configuration for Google login and Firestore sync.
# Copy this file to .env.local and fill in your values.
# If these are not set, the app works in cookie-only mode (no login).
#
# Steps:
# 1. Create a project at https://console.firebase.google.com
# 2. Add a Web app and copy the config values below
# 3. Enable Authentication → Google sign-in method
# 4. Enable Firestore Database (start in production mode)
# 5. Add a Firestore security rule:
#      allow read, write: if request.auth != null && request.auth.uid == userId;
#    (see https://firebase.google.com/docs/firestore/security/get-started)
# 6. Add the authorized domain (e.g. paulstansifer.github.io) under
#    Authentication → Settings → Authorized domains
#
# For the GitHub Actions deployment, add each variable as a repository secret
# (Settings → Secrets and variables → Actions).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
